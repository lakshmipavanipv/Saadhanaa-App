# ─── Gmail SMTP credentials ───────────────────────────────────────
# You MUST use a Google App Password, NOT your normal Gmail password.
# How to get one: see README.md, or visit https://myaccount.google.com/apppasswords
GMAIL_USER=your.gmail.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Saadhana

# ─── Server config ────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=*
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=5

# ─── SMS (optional) ───────────────────────────────────────────────
# Leave empty to disable SMS. Use 'textbelt' for free 1-SMS/day tier.
TEXTBELT_KEY=
