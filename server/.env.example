# Copy to .env on the server and fill in.

PORT=8080

# PostgreSQL connection
DATABASE_URL=postgres://bodysoul:CHANGE_ME@localhost:5432/bodysoul

# Firebase Admin — path to the service-account JSON downloaded from
# Firebase Console → Project settings → Service accounts → Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=/opt/body-soul-api/firebase-service-account.json

# Comma-separated allowed origins for CORS (the app itself doesn't need CORS,
# but a future web dashboard might). Leave * for now or restrict later.
CORS_ORIGIN=*
